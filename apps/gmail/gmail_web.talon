# https://support.google.com/mail/answer/6594
# NOTE: Keyboard shortcuts must be enabled in Gmail settings
# Settings > General > Keyboard shortcuts > Keyboard shortcuts on
tag: browser
browser.host: mail.google.com
-

# navigation
go [to] inbox:
    key(g)
    key(i)
go [to] starred:
    key(g)
    key(s)
go [to] snoozed:
    key(g)
    key(b)
go [to] sent:
    key(g)
    key(t)
go [to] drafts:
    key(g)
    key(d)
go [to] all mail:
    key(g)
    key(a)
go [to] contacts:
    key(g)
    key(c)
go [to] tasks:
    key(g)
    key(k)
newer conversation: key(k)
older conversation: key(j)
open conversation: key(o)
[go] back to list: key(u)
next message: key(n)
previous message: key(p)

# compose and send
compose [new message]: key(c)
compose in new window: key(d)
search mail: key(/)
send message: key(cmd-enter)
add cc: key(cmd-shift-c)
add bcc: key(cmd-shift-b)
insert link: key(cmd-k)

# actions
archive: key(e)
mute conversation: key(m)
report as spam: key(!)
delete: key(#)
mark as read: key(shift-i)
mark as unread: key(shift-u)
mark important: key(=)
mark not important: key(-)
snooze: key(b)
add to tasks: key(shift-t)
move to: key(v)
(labels | label): key(l)
star conversation: key(s)
reply: key(r)
reply all: key(a)
forward: key(f)

# selection
select all:
    key(*)
    key(a)
select none:
    key(*)
    key(n)
select read:
    key(*)
    key(r)
select unread:
    key(*)
    key(u)
select starred:
    key(*)
    key(s)
select unstarred:
    key(*)
    key(t)
toggle selection: key(x)

# application
keyboard shortcuts [show] | show keyboard shortcuts: key(?)
undo [last action]: key(z)
settings [open] | open settings: key(,)
